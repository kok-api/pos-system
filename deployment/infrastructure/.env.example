# Copy this file to .env in the same directory (deployment/infrastructure/.env)
# before running `docker compose up`, and fill in the required values.

COMPOSE_PROJECT_NAME=pos-system

POSTGRES_DB=pos_db
POSTGRES_USER=kok
POSTGRES_PASSWORD=kok@IT2345
POSTGRES_PORT=5432

REDIS_PORT=6379

JPA_DDL_AUTO=validate

GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
INVENTORY_SERVICE_PORT=8084

# Must decode (base64) to at least 32 bytes. Generate your own per environment, e.g.:
#   openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-output-from-openssl-rand-base64-32
JWT_ISSUER=pos-system/user-service
JWT_AUDIENCE=pos-system
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=PT15M

# Reserved for the planned user profile media integration; no upload API is implemented yet.
FILE_UPLOAD_SERVER_PATH=/var/lib/pos/catalog-uploads
FILE_UPLOAD_BASE_URI=http://localhost:8080/api/v1/files
CATALOG_FILE_UPLOAD_SERVER_PATH=/var/lib/pos/catalog-uploads
CATALOG_FILE_UPLOAD_BASE_URI=http://localhost:8080/api/v1/files

# Optional mail settings. Leave blank until email delivery is configured.
MAIL_USERNAME=
MAIL_PASSWORD=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
PGADMIN_PORT=5050
